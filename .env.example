NODE_ENV=development
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
PASSWORD_RESET_REDIRECT_URL=veronicalens://auth/reset-password
# Exact browser origins allowed by CORS, comma-separated. Leave empty for the mobile app.
CORS_ORIGINS=
# Server-only key that bypasses RLS; used for account deletion. Never expose it to the app.
SUPABASE_SECRET_KEY=replace-with-your-secret-key